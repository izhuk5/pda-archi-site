---
/* Главная. Секции – в порядке карты из docs/design-system.md, по одной за промпт:
   папка src/sections/<Имя>/ с <section id="<id>" class="section">, здесь – import Hero from '@sections/hero/hero.astro' и <Hero />.
   Имя id = имя в карте. Каждому появляющемуся элементу – data-reveal из docs/motion.md. */
import Base from '@layouts/base.astro';
import Header from '@components/header/header.astro';
import Footer from '@components/footer/footer.astro';
import Hero from '@sections/hero/hero.astro';
import About from '@sections/about/about.astro';
import Projects from '@sections/projects/projects.astro';
import Transformation from '@sections/transformation/transformation.astro';
import Expertise from '@sections/expertise/expertise.astro';
import DigitalLab from '@sections/digital-lab/digital-lab.astro';
import Clients from '@sections/clients/clients.astro';
import Contact from '@sections/contact/contact.astro';
---
<Base>
  <Header slot="header" />
  <Hero />
  <About />
  <Projects />
  <Transformation />
  <Expertise />
  <DigitalLab />
  <Clients />
  <Contact />
  <Footer slot="footer" />
</Base>
