---
/* Contact – целевое действие: фраза-призыв, контакты строками-ссылками, короткая форма (docs/design-system.md → Паттерны, «Контакт и подвал»).
   Форма до подключения отправки с сервера (вместе с CMS) открывает почтовую программу с готовым письмом – contact.js.
   Подвал – отдельный компонент Footer (слот footer каркаса). */
import './contact.css';
import Field from '@components/field/field.astro';
import Link from '@components/link/link.astro';
---
<section id="contact" class="section is-dark contact" aria-labelledby="contact-title">
  <div class="wrapper grid-12 contact-body">
    <h2 id="contact-title" class="contact-title display-l serif indent" data-reveal="lines">A building to transform? Tell us about it.</h2>
    <address class="contact-details" data-reveal="rows">
      <a class="contact-line" href="mailto:agence@pda.archi"><span class="body-s">Email</span><span class="title-m">agence@pda.archi</span></a>
      <a class="contact-line" href="tel:+33140059385"><span class="body-s">Phone</span><span class="title-m">+33&nbsp;1&nbsp;40&nbsp;05&nbsp;93&nbsp;85</span></a>
      <a class="contact-line" href="https://maps.google.com/?q=15+rue+du+Conservatoire+75009+Paris" target="_blank" rel="noopener"><span class="body-s">Studio</span><span class="title-m">15 rue du Conservatoire, 75009&nbsp;Paris</span></a>
      <a class="contact-line" href="https://www.instagram.com/pdaarchitecture/" target="_blank" rel="noopener"><span class="body-s">Instagram</span><span class="title-m">@pdaarchitecture</span></a>
    </address>
    <form class="contact-form" data-contact-form novalidate>
      <div class="contact-fields">
        <Field label="Name" name="name" type="text" autocomplete="name" required />
        <Field label="Company" name="company" type="text" autocomplete="organization" />
        <Field wide label="Email" name="email" type="email" autocomplete="email" required />
        <Field wide multiline label="The building and what you need" name="message" rows="3" required />
      </div>
      <div class="contact-submit">
        <button class="contact-button title-m" type="submit">Send</button>
        <p class="contact-note body-s">We use your details only to answer you. <Link href="https://www.pda.archi/politique-de-confidentialite" target="_blank" rel="noopener">Privacy policy</Link></p>
      </div>
      <p class="contact-status body-s" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  import './contact.js';
</script>
