---
/* Transformation – фирменный приём: Virtuose до и после в трёх главах (docs/design-system.md → Паттерны, «Пин-секция»).
   Без пина (≤ 767, ?static, reduced motion) – главы стопкой, шторка пальцем (Compare). С пином (от 768, transformation.js,
   приём compare-pin) – главы в одной строке сетки, шторку ведёт прокрутка, текст главы меняется строками из масок.
   Пары «стройка / готово» сняты в тех же пространствах, но не с одной точки – см. «Ручная доводка». */
import './transformation.css';
import Compare from '@components/compare/compare.astro';
import Facts from '@components/facts/facts.astro';
import entranceBefore from '@assets/img/transformation/entrance-before.jpg';
import entranceAfter from '@assets/img/transformation/entrance-after.jpg';
import courtyardBefore from '@assets/img/transformation/courtyard-before.jpg';
import courtyardAfter from '@assets/img/transformation/courtyard-after.jpg';
import topBefore from '@assets/img/transformation/top-before.jpg';
import topAfter from '@assets/img/transformation/top-after.jpg';

const chapters = [
  {
    title: 'The entrance',
    text: 'Built in 1901 as apartments. We rebuilt the entrance hall in noble materials and joined the street, the ground floor and the basement in one view.',
    before: entranceBefore, beforeAlt: 'The entrance hall during works',
    after: entranceAfter, afterAlt: 'The entrance hall after rehabilitation',
    label: 'The entrance: slide to compare during works and after',
  },
  {
    title: 'The courtyard',
    text: 'The basement under the courtyard had no daylight. We opened the courtyard floor and set a glass roof into it: below, an agora for work and events; above, a planted garden.',
    before: courtyardBefore, beforeAlt: 'The courtyard from above during works',
    after: courtyardAfter, afterAlt: 'The courtyard from above with the new glass roof over the agora',
    label: 'The courtyard: slide to compare during works and after',
  },
  {
    title: 'The top floor',
    text: 'New windows in the roof and reworked frames on the courtyard side bring daylight in. A new staircase made the floor larger.',
    before: topBefore, beforeAlt: 'The top floor during works, the Eiffel Tower through the window',
    after: topAfter, afterAlt: 'The finished top floor, the Eiffel Tower through the window',
    label: 'The top floor: slide to compare during works and after',
  },
];
---
<section id="transformation" class="section transformation" aria-labelledby="transformation-title">
  <div class="wrapper grid-12 transformation-body">
    <div class="transformation-head">
      <h2 id="transformation-title" class="display-l serif indent" data-reveal="lines">An apartment building from 1901, now prime offices.</h2>
      <Facts class="body-s">
        <div class="facts-row"><dt>Project</dt><dd>Virtuose, Paris 16. For PIMCO</dd></div>
        <div class="facts-row"><dt>Area</dt><dd>6&nbsp;548&nbsp;m²</dd></div>
        <div class="facts-row"><dt>Energy</dt><dd>−40% under the décret tertiaire</dd></div>
        <div class="facts-row"><dt>Certification</dt><dd>BREEAM, SmartScore, bio-based label</dd></div>
      </Facts>
    </div>
    <ol class="transformation-chapters">
      {chapters.map(c => (
        <li class="transformation-chapter">
          <div class="transformation-text">
            <h3 class="title-m">{c.title}</h3>
            <p class="body-m serif">{c.text}</p>
          </div>
          <Compare class="transformation-figure" before={c.before} after={c.after} beforeAlt={c.beforeAlt} afterAlt={c.afterAlt} label={c.label}><span>During works</span><span>2025</span></Compare>
        </li>
      ))}
    </ol>
    <div class="transformation-progress body-s" aria-hidden="true"><span class="transformation-count">1 / 3</span></div>
  </div>
</section>

<script>
  import './transformation.js';
</script>
