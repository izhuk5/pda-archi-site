   Окна – все 13: 8 избранных + 5 для строк clients (125 Saussure, Le Biopark, Timbre, Verde, Coopération); их открывает
   любая кнопка [data-project] на странице (ProjectSheet.js). Тексты – здесь, данными (при переходе на CMS выносятся):
   перевод технических карточек pda.archi, предлагаю заменить текстами клиента. Фото – src/assets/img/projects/<photo>.jpg.
   \u00a0 – неразрывный пробел (число и единица, «m²»). */
import './Projects.css';
import SectionHead from '@components/SectionHead/SectionHead.astro';
import ProjectCard from '@components/ProjectCard/ProjectCard.astro';
import ProjectSheet from '@components/ProjectSheet/ProjectSheet.astro';

const images = import.meta.glob('/src/assets/img/projects/*.jpg', { eager: true, import: 'default' });
const photo = name => {
  const img = images[`/src/assets/img/projects/${name}.jpg`];
  if (!img) throw new Error(`projects: нет фото src/assets/img/projects/${name}.jpg`);
  return img;
};

