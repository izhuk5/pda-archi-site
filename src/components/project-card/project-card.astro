---
/* Карточка проекта – не ссылка и не кнопка (окон и страниц проектов нет). Фото в рамке, под ним две строки Caption:
   название и площадь, тип и год. Пропорцию рамки задаёт секция (shape влияет только на sizes картинки). Hover card-zoom. */
import './project-card.css';
import Photo from '@components/photo/photo.astro';
import Caption from '@components/caption/caption.astro';

const { photo, alt, shape = 'wide', name, area, type, year } = Astro.props;
/* Широкая карточка – 7 колонок, высокая – 4; до 767 – во всю ширину. Ширины не больше исходника */
const sizes =
  shape === 'wide' ? '(max-width: 767px) 100vw, 58vw' : '(max-width: 767px) 100vw, 34vw';
const widths = [480, 800, 1100, 1600].filter(w => w <= photo.width);
---

<div class="project-card">
  <span class="project-card-frame" data-reveal="clip">
    <Photo
      class="project-card-photo"
      src={photo}
      widths={widths}
      sizes={sizes}
      loading="lazy"
      alt={alt}
    />
  </span>
  <Caption as="span" keep class="project-card-caption body-s">
    <span>{name}</span>
    <span>{area}</span>
  </Caption>
  <Caption as="span" keep class="project-card-caption body-s">
    <span>{type}</span>
    <span>{year}</span>
  </Caption>
</div>
