---
/* Ссылка с линией (приём link-line, docs/motion.md). Использование: <Link href="#projects">Projects</Link>.
   quiet – меню и подвал: в покое линии нет, растёт при наведении (на старом сайте – .ulink).
   Без quiet – ссылка в тексте и активная: линия видна, при наведении уезжает вправо.
   class – классы места (маска строки в шапке, ячейка сетки); остальные атрибуты (target, rel, aria-*) уходят на <a>. */
import './Link.css';

const { quiet = false, class: className, ...attrs } = Astro.props;
---
<a class:list={['link', { 'is-quiet': quiet }, className]} {...attrs}><slot /></a>
