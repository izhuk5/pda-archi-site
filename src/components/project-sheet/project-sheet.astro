---
/* Окно проекта: <dialog id="project-<id>"> на весь экран. Слева – тип, описание, факты, авторы фото (прилипают), справа – галерея.
   Открывает любая кнопка [data-project="<id>"] (карточка projects, строка clients), логика – project-sheet.js.
   photos – [{ src: ImageMetadata, alt }]; facts – [[название, значение]]. data-lenis-prevent – колесо крутит окно, а не страницу. */
import './project-sheet.css';
import { Image } from 'astro:assets';
import Facts from '@components/facts/facts.astro';

const { id, title, type, text = [], facts = [], credit, photos = [] } = Astro.props;
const widths = src => [480, 800, 1100, 1600].filter(w => w <= src.width);
---
<dialog id={`project-${id}`} class="project-sheet" aria-labelledby={`project-${id}-title`} data-lenis-prevent>
  <div class="project-sheet-inner grid-12">
    <div class="project-sheet-info">
      <div class="project-sheet-head">
        <h3 id={`project-${id}-title`} class="display-s">{title}</h3>
        <button class="project-sheet-close body-s" type="button" data-close>Close</button>
      </div>
      <p class="body-s">{type}</p>
      {text.map(t => <p class="body-l">{t}</p>)}
      <Facts class="body-s">
        {facts.map(([dt, dd]) => <div class="facts-row"><dt>{dt}</dt><dd>{dd}</dd></div>)}
      </Facts>
      <p class="body-s">{credit}</p>
    </div>
    <div class="project-sheet-gallery">
      {photos.map(p => <Image class="project-sheet-photo" src={p.src} widths={widths(p.src)} sizes="(max-width: 767px) 100vw, 58vw" loading="lazy" alt={p.alt} />)}
    </div>
  </div>
</dialog>

<script>
  import './project-sheet.js';
</script>
