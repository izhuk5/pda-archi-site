---
/* Фото сайта: <picture> – AVIF в <source>, WebP в самом <img>. Браузер берёт AVIF, если понимает, иначе WebP
   (WebP – все браузеры с 2020 года, Safari 14+; JPG больше не нужен). WebP в src, а не JPG: проверки «картинки не в
   современном формате» смотрят только на src у <img>, а не на <source>.
   Форматы и ширины Astro готовит при сборке (getImage), сервер не нужен.
   <Photo src={photo} widths={[800, 1600]} sizes="50vw" alt="Описание кадра" />
   – mobile, mobileWidths – свой кадр для телефона (≤ 478 px): отдельные <source media> в AVIF и WebP (запасной <img> – основной кадр);
   – class – на <img>; pictureClass – на <picture>. Без него <picture> – display: contents (base.css), и <img> стоит в раскладке
     так, будто обёртки нет;
   – остальные атрибуты (data-reveal, fetchpriority) – на <img>. */
import { getImage } from 'astro:assets';

const MOBILE = '(max-width: 478px)';
/* Основной кадр: AVIF в <source>, WebP – в <img>. Мобильный кадр: оба формата в <source> – у <img> его нет */
const MAIN_SOURCES = ['avif'];
const MOBILE_SOURCES = ['avif', 'webp'];
const FALLBACK = 'webp';

const {
  src,
  widths,
  sizes,
  alt,
  loading = 'lazy',
  mobile,
  mobileWidths,
  class: className,
  pictureClass,
  ...rest
} = Astro.props;

const sources = (image, imageWidths, formats, media) =>
  Promise.all(
    formats.map(async format => {
      const img = await getImage({ src: image, widths: imageWidths, sizes, format });
      return { media, format, img };
    }),
  );

const mobileSources = mobile ? await sources(mobile, mobileWidths, MOBILE_SOURCES, MOBILE) : [];
const mainSources = await sources(src, widths, MAIN_SOURCES);
const fallback = await getImage({ src, widths, sizes, format: FALLBACK });
---

<picture class={pictureClass}>
  {[...mobileSources, ...mainSources].map(({ media, format, img }) => (
    <source
      media={media}
      type={`image/${format}`}
      srcset={img.srcSet.attribute}
      sizes={sizes}
      width={img.attributes.width}
      height={img.attributes.height}
    />
  ))}
  <img
    class={className}
    src={fallback.src}
    srcset={fallback.srcSet.attribute}
    sizes={sizes}
    width={fallback.attributes.width}
    height={fallback.attributes.height}
    alt={alt}
    loading={loading}
    decoding="async"
    {...rest}
  />
</picture>
