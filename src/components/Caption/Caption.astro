---
/* Подпись к фото: название проекта слева, факты справа (факты не переносятся); на телефоне – столбиком.
   Внутри – два <span>: <Caption><span>Virtuose, Paris 16</span><span>6 500 m²</span></Caption>.
   rule – линия сверху (подпись поверх фото); keep – остаётся строкой на телефоне; as – тег (p по умолчанию, figcaption в figure).
   class – классы места; остальные атрибуты (data-reveal…) уходят на элемент. */
import './Caption.css';

const { as: Tag = 'p', rule = false, keep = false, class: className, ...attrs } = Astro.props;
---
<Tag class:list={['caption', { 'is-rule': rule, 'is-keep': keep }, className]} {...attrs}><slot /></Tag>
