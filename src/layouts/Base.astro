---
/* Каркас каждой страницы: <head>, шрифты, глобальные стили, запуск движения.
   Использование: <Base title="…" description="…"> секции </Base>.
   Глобальные стили – только токены и база; стили секций и компонентов живут в их .astro-файлах (<style>, Astro их скоупит). */
import '@styles/tokens.css';
import '@styles/base.css';

const {
  title = 'PDA Architecture – Paris architects for existing buildings',
  description = 'PDA Architecture, Paris, since 2002: we transform existing buildings – offices into homes, Haussmann facades, old offices raised to BREEAM.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>

  {/* Шрифты: свои файлы в public/fonts/, @font-face – в src/styles/base.css. Предзагрузка – оба начертания нужны первому экрану */}
  <link rel="preload" href="/fonts/NeueMontreal-Regular.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/HedvigLettersSerif18pt-Regular.woff2" as="font" type="font/woff2" crossorigin>

  {/* Движение включено, если нет ?static и prefers-reduced-motion: класс ставится до первой отрисовки, иначе контент
      сначала мелькнёт, потом спрячется под появление. Если движение не запустилось, js/main.js класс снимает и всё показывает */}
  <script is:inline>
    if (!new URLSearchParams(location.search).has('static') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('has-motion');
    }
  </script>
</head>
<body>
  {/* Шапка и подвал – вне <main>: на главной это SiteHeader и SiteFooter (slot="header" / slot="footer") */}
  <slot name="header" />
  <main>
    <slot />
  </main>
  <slot name="footer" />

  {/* Движение и 3D: GSAP, Lenis, Three.js из npm, Astro собирает их сам. Three.js грузится отдельным файлом, только если на странице есть [data-scene] */}
  <script>
    import '@lib/main.js';
  </script>
</body>
</html>
