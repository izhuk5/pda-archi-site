{
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[astro]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "prettier.requireConfig": true,
  "prettier.documentSelectors": [
    "**/*.astro"
  ],
  "cssVariables.lookupFiles": [
    "**/src/styles/tokens.css"
  ],
  "cssVariables.blacklistFolders": [
    "**/.git",
    "**/node_modules",
    "**/dist",
    "**/dist/**",
    "**/.astro",
    "**/.astro/**",
    "**/scripts/out"
  ]
}
